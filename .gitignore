# ---------------------------------------------------------------------------
# Opportunity Intelligence Engine: what must never be committed.
# Rule of thumb: source, fixtures (fictional only) and docs are tracked;
# anything holding secrets, sessions, real research data or build output is not.
# ---------------------------------------------------------------------------

# --- Dependencies ---
node_modules/
.pnp.*
.yarn/

# --- Build output and tool caches ---
.next/
out/
build/
dist/
.turbo/
.vercel/
.cache/
*.tsbuildinfo
next-env.d.ts
.eslintcache
coverage/
.nyc_output/

# --- Environment files: everything except the sanitized example ---
.env
.env.local
.env.*.local
.env.*
!.env.example
*.env
.envrc
.dev.vars

# --- Keys, certificates, credential files ---
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*
*.gpg
*.asc
.npmrc
.netrc
.pypirc
.htpasswd
credentials.json
credentials.*.json
client_secret*.json
*service-account*.json
*serviceaccount*.json
*-credentials.json
token.json
tokens.json
secrets.json
secrets.y*ml
*.secret
*.secrets
.aws/
.gcloud/
.azure/
.ssh/
supabase/.env
supabase/.temp/
supabase/.branches/

