private/
private-research/
research-private/
research-data/
research-notes/
real-runs/
/exports/
report-exports/
/downloads/
/leads/
/prospects/
*.private.md
*.private.json
*.leads.csv
*.prospects.csv

# --- Logs and crash/diagnostic dumps ---
/logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.heapsnapshot
*.heapprofile
*.cpuprofile
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Test and browser-automation output ---
test-results/
playwright-report/
blob-report/
*.trace.zip
/videos/

# --- Scanner output (may quote the secrets it found) ---
gitleaks-report.*
trufflehog-report.*
.secrets.baseline

# --- Local assistant/editor/OS state ---
.claude/settings.local.json
.claude/*.local.*
