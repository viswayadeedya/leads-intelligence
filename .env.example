# Copy to .env.local (untracked). Leave everything unset to run in mock mode.
# Never commit actual credentials. Secret placeholders below must stay empty.

# This build always runs in mock mode. Setting "live" only shows a warning banner.
NEXT_PUBLIC_APP_MODE=mock

# --- Sign-in -------------------------------------------------------------
# Leave this EMPTY for normal use. On first run the sign-in page asks for a
# one-time setup code (written to <data folder>/setup-code.txt) and lets you
# choose a passphrase; only a salted hash of it is stored.
# Set it only if you need to supply the passphrase from the environment. It
# is then kept here in plain text, must be at least 12 characters, and
# replaces the stored passphrase for as long as it is set.
OPERATOR_PASSPHRASE=
# Minutes without activity before a session ends (the total limit is SESSION_TTL_MINUTES).
SESSION_IDLE_MINUTES=60
MAX_SESSIONS=5
# Extra host names this app may be reached under, comma-separated. localhost,
# 127.0.0.1 and [::1] are always allowed; any other Host header is refused.
OI_ALLOWED_HOSTS=

# --- Credentials (all unused in this build; shown only as present/absent) --
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=

# --- Budgets and limits (non-secret) ---------------------------------------
MAX_INVESTIGATION_COST_CENTS=50
MAX_INVESTIGATION_REQUESTS=30
MAX_PAGES_PER_SITE=5
MAX_RETRIES_PER_RUN=2
MAX_RUNS_PER_HOUR=20
STALE_AFTER_DAYS=180
SESSION_TTL_MINUTES=480
APPROVAL_TTL_MINUTES=60

# --- Live fetch limits (used only by the not-yet-enabled live transport) ---
MAX_RESPONSE_BYTES=1000000
FETCH_TIMEOUT_MS=10000
MAX_REDIRECTS=3

# Where mock-mode data is stored (a single JSON file). Default: .data
OI_DATA_DIR=
